{
  "name": "radiohuasteca",
  "private": true,
  "version": "0.1.0",
  "description": "Plataforma web de radio comunitaria indígena de baja conectividad para Santa Ana Hueytlalpan, Hidalgo.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "server": "node server/index.js",
    "db:init": "node server/init-db.js",
    "admin:create": "node server/create-admin.js",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "verify:sprint1": "node scripts/verify-sprint-1.mjs",
    "verify:sprint2": "node scripts/verify-sprint-2.mjs",
    "verify:sprint3": "node scripts/verify-sprint-3.mjs",
    "verify:sprint5": "node scripts/verify-sprint-5.mjs",
    "evidence:sprint4": "node scripts/capture-sprint-4-evidence.mjs",
    "audio:generate": "bash scripts/generate-bulletin-audio.sh"
  },
  "dependencies": {
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "lucide-react": "^1.47.0",
    "pg": "^8.16.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.0"
  }
}
